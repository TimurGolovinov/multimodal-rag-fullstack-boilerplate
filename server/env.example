# ===========================================
# RAG APPLICATION - ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and update with your actual values
# NEVER commit .env files to version control!

# ===========================================
# CRITICAL SECURITY SETTINGS
# ===========================================
# These MUST be set for production deployment
# Generate strong, unique secrets for each environment

# JWT Authentication Secrets (REQUIRED)
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-in-production
REFRESH_TOKEN_SECRET=your-super-secret-refresh-key-change-in-production

# CSRF Protection Secret (REQUIRED)
# Generate with: openssl rand -base64 32
CSRF_SECRET=your-csrf-secret-change-in-production

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rag_app
DB_USER=rag_user
DB_PASSWORD=your_secure_database_password
DB_SSL=false
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password

# ===========================================
# OPENAI API CONFIGURATION
# ===========================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=3000
NODE_ENV=development

# ===========================================
# SECURITY SETTINGS
# ===========================================
# CORS - Comma-separated list of allowed domains
# Use exact domains or wildcards (e.g., *.yourdomain.com)
ALLOWED_DOMAINS=localhost,127.0.0.1,yourdomain.com,*.yourdomain.com

# CORS Security - Allow requests without origin in development mode
# Automatically enabled in development, set to "true" for production tools like Postman
ALLOW_NO_ORIGIN=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_PROCESSING_MAX=10

# ===========================================
# FILE UPLOAD CONFIGURATION
# ===========================================
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=pdf,doc,docx,txt,jpg,jpeg,png,gif,mp3,wav,mp4,avi
THUMBNAIL_QUALITY=80
CLEANUP_INTERVAL=86400000

# ===========================================
# STORAGE CONFIGURATION
# ===========================================
# Storage type: local, s3, or hybrid
STORAGE_TYPE=local

# S3 Configuration (if using S3 or hybrid storage)
S3_REGION=us-east-1
S3_BUCKET=your-s3-bucket-name
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_FALLBACK_TO_LOCAL=true

# ===========================================
# PASSWORD SECURITY
# ===========================================
BCRYPT_SALT_ROUNDS=12

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ===========================================
# MONITORING & ALERTING
# ===========================================
# Health check settings
HEALTH_CHECK_INTERVAL=30000

# ===========================================
# PRODUCTION SETTINGS
# ===========================================
# Uncomment and configure for production
# HTTPS_ENABLED=true
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
# TRUST_PROXY=true
