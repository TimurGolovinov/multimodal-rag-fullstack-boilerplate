{
  "name": "rag-starter-kit",
  "version": "2.0.0",
  "description": "Advanced RAG application with PostgreSQL database and Docker support",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "client": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "client:start": "npm run preview --prefix client",
    "dev:all": "npm run dev --prefix client & npm run dev",
    "migrate": "ts-node src/database/migration/migrate.ts",
    "db:setup": "ts-node src/database/setup.ts",
    "db:seed": "ts-node src/database/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "docker:build": "docker build -t rag-app .",
    "docker:run": "docker run -p 3000:3000 rag-app",
    "docker:compose": "docker compose up -d",
    "docker:logs": "docker compose logs -f",
    "docker:stop": "docker compose down"
  },
  "keywords": [
    "rag",
    "llm",
    "vector-search",
    "typescript",
    "node",
    "postgresql",
    "docker",
    "ai",
    "chatbot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.450.0",
    "@aws-sdk/s3-request-presigner": "^3.450.0",
    "axios": "^1.6.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "ffmpeg-static": "^5.2.0",
    "helmet": "^7.1.0",
    "mammoth": "^1.6.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^5.12.2",
    "pdf-parse": "^1.1.1",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ffmpeg-static": "^3.0.3",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "@types/jest": "^29.5.8",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/rag-application.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/rag-application/issues"
  },
  "homepage": "https://github.com/yourusername/rag-application#readme"
}
